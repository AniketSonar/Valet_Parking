PORT=5000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Applied to 10-digit numbers saved without a country code (91 = India)
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# false = plain text + media (only delivered inside the 24h customer window,
#         fine for testing with your own number)
# true  = Meta-approved templates (required in production)
WHATSAPP_USE_TEMPLATES=false
WHATSAPP_TEMPLATE_LANGUAGE=en
